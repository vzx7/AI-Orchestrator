# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env and update values

# ============================================
# Registry / Image
# ============================================
REGISTRY=ghcr.io
IMAGE_PREFIX=your-org
VERSION=latest

# ============================================
# Security
# ============================================
API_KEY=change-me-generate-secure-random-key
POSTGRES_PASSWORD=change-me-secure-password
GRAFANA_PASSWORD=change-me-admin-password

# ============================================
# Database
# ============================================
POSTGRES_DB=orchestrator
POSTGRES_USER=admin

# ============================================
# Logging
# ============================================
LOG_LEVEL=info  # debug, info, warn, error

# ============================================
# Optional Features
# ============================================
# Enable monitoring (run with: docker-compose --profile monitoring up)
# GRAFANA_PASSWORD=admin